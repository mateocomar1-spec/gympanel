HOST=127.0.0.1
PORT=3000
SEED_DEMO=true
# Para una base real vacía, usar un DATA_DIR nuevo y SEED_DEMO=false.
# DATA_DIR=/ruta/a/volumen/persistente
# Configurar una contraseña fuerte de al menos 16 caracteres antes de exponer el servidor.
# OWNER_PASSWORD=
# Reemplazar por el email real del responsable para enviar push.
PUSH_SUBJECT=mailto:admin@example.com

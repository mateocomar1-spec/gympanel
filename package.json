{
  "name": "gympanel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test test/app.test.js test/runtime.test.js test/management.test.js && npm run test:ui",
    "test:ui": "node --test --test-isolation=none test/interface.test.js",
    "check": "node --check server.js && node --check public/app.js && node --check public/sw.js && node --check cloudflare/worker.js && node --check scripts/cloudflare-setup.mjs && node --check scripts/cloudflare-deploy.mjs",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:setup": "node scripts/cloudflare-setup.mjs",
    "cloudflare:build": "wrangler deploy --dry-run --outdir work/cloudflare-build",
    "cloudflare:migrate:local": "wrangler d1 migrations apply DB --local",
    "cloudflare:migrate": "wrangler d1 migrations apply DB --remote",
    "cloudflare:deploy": "node scripts/cloudflare-deploy.mjs",
    "test:cloudflare": "npm run cloudflare:build && node --test cloudflare/test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "linkedom": "^0.18.15",
    "miniflare": "^5.20261102.0-beta",
    "wrangler": "^4.156.2"
  }
}

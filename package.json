{
  "name": "gympanel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check public/app.js && node --check public/sw.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  }
}
